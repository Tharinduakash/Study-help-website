# Copy to .env.local for local development, and add the same values in Vercel.

# Your live address, without a trailing slash. Used by the sitemap, SEO tags and email links.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase > Connect > Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase > Project Settings > API. The service role key is a full-access secret:
# never prefix it with NEXT_PUBLIC_ and never share it.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com). The sender domain must be verified there.
RESEND_API_KEY=
EMAIL_FROM=Study Help <notifications@example.com>
ADMIN_NOTIFICATION_EMAIL=
